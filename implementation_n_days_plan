#### [MODIFY] [V20260601__create_system_config.sql](file:///d:/Java%20lean/TMDT/backend/src/main/resources/db/migration/V20260601__create_system_config.sql)
Bổ sung câu lệnh tạo bảng `system_config_audit` vì bảng này đang được sử dụng trong Entity và Service nhưng chưa được định nghĩa trong Migration.

```sql
CREATE TABLE IF NOT EXISTS system_config (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    config_key VARCHAR(255) NOT NULL UNIQUE,
    config_value VARCHAR(255) NOT NULL
);

CREATE TABLE IF NOT EXISTS system_config_audit (
    id BIGINT AUTO_INCREMENT PRIMARY KEY,
    config_key VARCHAR(255) NOT NULL,
    old_value VARCHAR(255),
    new_value VARCHAR(255) NOT NULL,
    changed_by BIGINT,
    changed_at DATETIME NOT NULL
);

-- Insert default discount max days value (7 days)
INSERT INTO system_config (config_key, config_value) VALUES ('discount.max.days', '7')
    ON DUPLICATE KEY UPDATE config_value = config_value;
```

